# ── D-ID ──────────────────────────────────────────────────────────────
# Your D-ID API key. In D-ID Studio: top-right menu → "API keys" (or
# Account Settings → API). Copy the key exactly as shown — it is already a
# Basic-auth token (looks like "Z29vZ2xl...:abcd1234").
DID_API_KEY=

# D-ID API base. Leave as-is unless told otherwise.
DID_API_URL=https://api.d-id.com

# ── The "brain" (OpenAI) ──────────────────────────────────────────────
# Generates the angel + devil replies and SEES you via the webcam frame.
# Get one at https://platform.openai.com/api-keys. Use a vision-capable model.
OPENAI_API_KEY=
BRAIN_MODEL=gpt-4o

# ── Avatar faces ──────────────────────────────────────────────────────
# Publicly reachable image URLs (a clear, front-facing face works best).
# Swap these for your own angel / devil art for the real demo.
ANGEL_IMAGE_URL=https://d-id-public-bucket.s3.us-west-2.amazonaws.com/alice.jpg
DEVIL_IMAGE_URL=https://d-id-public-bucket.s3.us-west-2.amazonaws.com/or-roman.jpg

# ── ElevenLabs voices ─────────────────────────────────────────────────
# Default voice IDs from your ElevenLabs account. D-ID calls ElevenLabs to
# speak these (via the key you connected in D-ID Studio → Integrations).
ANGEL_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DEVIL_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Your ElevenLabs API key — needed HERE (not just in D-ID Studio) for the
# "Use my voice" feature, which clones a voice via the ElevenLabs API. Use the
# SAME ElevenLabs account you connected in D-ID Studio, so D-ID can speak the
# cloned voice. Get it at https://elevenlabs.io → Profile → API key.
# Note: Instant Voice Cloning requires a paid ElevenLabs plan (Starter+).
ELEVENLABS_API_KEY=

PORT=3000
