# ── D-ID ──────────────────────────────────────────────────────────────
# Your D-ID API key. In D-ID Studio: top-right menu → "API keys" (or
# Account Settings → API). Copy the key exactly as shown — it is already a
# Basic-auth token (looks like "Z29vZ2xl...:abcd1234").
DID_API_KEY=

# D-ID API base. Leave as-is unless told otherwise.
DID_API_URL=https://api.d-id.com

# ── The "brain" (OpenAI) ──────────────────────────────────────────────
# Generates the angel + devil replies, SEES you via the webcam frame, AND
# transcribes your held-to-talk speech (server-side, via Whisper).
# Get one at https://platform.openai.com/api-keys. Use a vision-capable model.
OPENAI_API_KEY=
BRAIN_MODEL=gpt-4o-mini

# ── Avatar faces ──────────────────────────────────────────────────────
# Publicly reachable image URLs (a clear, front-facing face works best).
# Swap these for your own angel / devil art for the real demo.
ANGEL_IMAGE_URL=https://d-id-public-bucket.s3.us-west-2.amazonaws.com/alice.jpg
DEVIL_IMAGE_URL=https://d-id-public-bucket.s3.us-west-2.amazonaws.com/or-roman.jpg

# ── ElevenLabs voices ─────────────────────────────────────────────────
# Voice IDs each avatar speaks with. Can be public ElevenLabs library voices
# or PRIVATE voices from your own account (designed or cloned).
ANGEL_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DEVIL_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Your ElevenLabs API key. The server forwards it to D-ID (via the
# `x-api-key-external` header) so D-ID can speak voices from YOUR account —
# including private designed/cloned voices it otherwise couldn't reach. It also
# powers "Use my voice" (Instant Voice Cloning). Get it at
# https://elevenlabs.io → Profile → API key.
# Note: Instant Voice Cloning + private voices need a paid ElevenLabs plan (Starter+).
ELEVENLABS_API_KEY=

# Abuse guard for a public deploy: seconds of generated avatar audio allowed per
# IP per rolling window (default 180s = 3 min, per 1h). Bump for your own demo
# recording if needed. (In-memory → best-effort on serverless.)
AUDIO_BUDGET_SECONDS=180
AUDIO_WINDOW_MS=3600000

PORT=3000
